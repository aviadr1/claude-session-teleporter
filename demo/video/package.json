{
  "name": "claude-session-teleporter-video",
  "private": true,
  "version": "1.0.0",
  "description": "Promo video for claude-session-teleporter, rendered with Remotion from real captured tool output",
  "scripts": {
    "capture": "python capture/capture.py",
    "studio": "remotion studio",
    "render": "remotion render Teleporter ../../docs/teleporter-demo.mp4 --codec h264 --crf 22 --x264-preset slow",
    "gif": "sh make-gif.sh",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "jetbrains-mono": "1.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
